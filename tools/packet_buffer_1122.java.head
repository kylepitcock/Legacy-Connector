package legacyconnector.v1_12_2.net.minecraft.network;

import io.netty.buffer.ByteBuf;
import io.netty.buffer.ByteBufInputStream;
import io.netty.buffer.ByteBufOutputStream;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.UUID;
import legacyconnector.v1_12_2.net.minecraft.item.Item;
import legacyconnector.v1_12_2.net.minecraft.item.ItemStack;
import legacyconnector.v1_12_2.net.minecraft.nbt.NBTTagCompound;
import legacyconnector.v1_12_2.net.minecraft.util.ResourceLocation;
import legacyconnector.v1_12_2.net.minecraft.util.math.BlockPos;

/**
 * 1.12.2's packet buffer: a ByteBuf around another one, with the vanilla helpers for var ints, strings, NBT, stacks and
 * positions in the 1.12 wire format. The ByteBuf methods below the helpers delegate to the wrapped buffer (generated by
 * tools/gen_packet_buffer.py from tools/packet_buffer_1122.java.head; edit that and regenerate).
 */
public class PacketBuffer extends ByteBuf {
    private final ByteBuf buf;

    public PacketBuffer(ByteBuf wrapped) {
        this.buf = wrapped;
    }

    public static int getVarIntSize(int value) {
        for (int i = 1; i < 5; i++) if ((value & -1 << i * 7) == 0) return i;
        return 5;
    }

    public PacketBuffer writeByteArray(byte[] array) {
        writeVarInt(array.length);
        writeBytes(array);
        return this;
    }

    public byte[] readByteArray() {
        return readByteArray(readableBytes());
    }

    public byte[] readByteArray(int maxLength) {
        int length = readVarInt();
        if (length > maxLength) throw new io.netty.handler.codec.DecoderException("ByteArray with size " + length + " is bigger than allowed " + maxLength);
        byte[] out = new byte[length];
        readBytes(out);
        return out;
    }

    public PacketBuffer writeVarIntArray(int[] array) {
        writeVarInt(array.length);
        for (int v : array) writeVarInt(v);
        return this;
    }

    public int[] readVarIntArray() {
        return readVarIntArray(readableBytes());
    }

    public int[] readVarIntArray(int maxLength) {
        int length = readVarInt();
        if (length > maxLength) throw new io.netty.handler.codec.DecoderException("VarIntArray with size " + length + " is bigger than allowed " + maxLength);
        int[] out = new int[length];
        for (int i = 0; i < length; i++) out[i] = readVarInt();
        return out;
    }

    public PacketBuffer writeLongArray(long[] array) {
        writeVarInt(array.length);
        for (long v : array) writeLong(v);
        return this;
    }

    public long[] readLongArray(long[] into) {
        return readLongArray(into, readableBytes() / 8);
    }

    public long[] readLongArray(long[] into, int maxLength) {
        int length = readVarInt();
        if (into == null || into.length != length) {
            if (length > maxLength) throw new io.netty.handler.codec.DecoderException("LongArray with size " + length + " is bigger than allowed " + maxLength);
            into = new long[length];
        }
        for (int i = 0; i < into.length; i++) into[i] = readLong();
        return into;
    }

    public BlockPos readBlockPos() {
        return BlockPos.fromLong(readLong());
    }

    public PacketBuffer writeBlockPos(BlockPos pos) {
        writeLong(pos.toLong());
        return this;
    }

    public <T extends Enum<T>> T readEnumValue(Class<T> type) {
        return type.getEnumConstants()[readVarInt()];
    }

    public PacketBuffer writeEnumValue(Enum<?> value) {
        return writeVarInt(value.ordinal());
    }

    public int readVarInt() {
        int value = 0;
        int shift = 0;
        byte b;
        do {
            b = readByte();
            value |= (b & 127) << shift++ * 7;
            if (shift > 5) throw new RuntimeException("VarInt too big");
        } while ((b & 128) == 128);
        return value;
    }

    public long readVarLong() {
        long value = 0L;
        int shift = 0;
        byte b;
        do {
            b = readByte();
            value |= (long) (b & 127) << shift++ * 7;
            if (shift > 10) throw new RuntimeException("VarLong too big");
        } while ((b & 128) == 128);
        return value;
    }

    public PacketBuffer writeUniqueId(UUID uuid) {
        writeLong(uuid.getMostSignificantBits());
        writeLong(uuid.getLeastSignificantBits());
        return this;
    }

    public UUID readUniqueId() {
        return new UUID(readLong(), readLong());
    }

    public PacketBuffer writeVarInt(int value) {
        while ((value & -128) != 0) {
            writeByte(value & 127 | 128);
            value >>>= 7;
        }
        writeByte(value);
        return this;
    }

    public PacketBuffer writeVarLong(long value) {
        while ((value & -128L) != 0L) {
            writeByte((int) (value & 127L) | 128);
            value >>>= 7;
        }
        writeByte((int) value);
        return this;
    }

    /** A compound in the 1.12 form: a single 0 byte for null, else the unnamed tag. */
    public PacketBuffer writeCompoundTag(NBTTagCompound tag) {
        if (tag == null) {
            writeByte(0);
        } else {
            try {
                net.minecraft.nbt.NbtIo.writeAnyTag(tag.mcc$modern(), new ByteBufOutputStream(this));
            } catch (IOException e) {
                throw new io.netty.handler.codec.EncoderException(e);
            }
        }
        return this;
    }

    public NBTTagCompound readCompoundTag() throws IOException {
        int start = readerIndex();
        if (readByte() == 0) return null;
        readerIndex(start);
        try {
            var tag = net.minecraft.nbt.NbtIo.readAnyTag(new ByteBufInputStream(this), net.minecraft.nbt.NbtAccounter.create(2097152L));
            return tag instanceof net.minecraft.nbt.CompoundTag c ? new NBTTagCompound(c) : new NBTTagCompound();
        } catch (RuntimeException e) {
            throw new IOException(e);
        }
    }

    public PacketBuffer writeItemStack(ItemStack stack) {
        if (stack == null || stack.isEmpty()) {
            writeShort(-1);
        } else {
            writeShort(Item.getIdFromItem(stack.getItem()));
            writeByte(stack.getCount());
            writeShort(stack.getMetadata());
            writeCompoundTag(stack.getTagCompound());
        }
        return this;
    }

    public ItemStack readItemStack() throws IOException {
        int id = readShort();
        if (id < 0) return ItemStack.EMPTY;
        int count = readByte();
        int meta = readShort();
        ItemStack stack = new ItemStack(Item.getItemById(id), count, meta);
        stack.setTagCompound(readCompoundTag());
        return stack;
    }

    public String readString(int maxLength) {
        int length = readVarInt();
        if (length > maxLength * 4) throw new io.netty.handler.codec.DecoderException("The received encoded string buffer length is longer than maximum allowed (" + length + " > " + maxLength * 4 + ")");
        if (length < 0) throw new io.netty.handler.codec.DecoderException("The received encoded string buffer length is less than zero! Weird string!");
        String text = toString(readerIndex(), length, StandardCharsets.UTF_8);
        readerIndex(readerIndex() + length);
        if (text.length() > maxLength) throw new io.netty.handler.codec.DecoderException("The received string length is longer than maximum allowed (" + length + " > " + maxLength + ")");
        return text;
    }

    public PacketBuffer writeString(String text) {
        byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
        if (bytes.length > 32767) throw new io.netty.handler.codec.EncoderException("String too big (was " + bytes.length + " bytes encoded, max 32767)");
        writeVarInt(bytes.length);
        writeBytes(bytes);
        return this;
    }

    public ResourceLocation readResourceLocation() {
        return new ResourceLocation(readString(32767));
    }

    public PacketBuffer writeResourceLocation(ResourceLocation location) {
        return writeString(location.toString());
    }

    public java.util.Date readTime() {
        return new java.util.Date(readLong());
    }

    public PacketBuffer writeTime(java.util.Date time) {
        writeLong(time.getTime());
        return this;
    }

    // ReferenceCounted (not redeclared by ByteBuf)
    @Override
    public int refCnt() {
        return buf.refCnt();
    }

    @Override
    public boolean release() {
        return buf.release();
    }

    @Override
    public boolean release(int decrement) {
        return buf.release(decrement);
    }

    // @@DELEGATES@@
}
